{
  "expo": {
    "name": "Pixel Stories",
    "slug": "storybook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b16",
    "splash": {
      "backgroundColor": "#0b0b16"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b16"
      },
      "package": "com.pixelstories.app",
      "permissions": [
        "android.permission.INTERNET"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-navigation-bar"
    ],
    "scheme": "pixelstories",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {},
      "eas": {
        "projectId": "4a474a1e-b207-4d84-ad49-0142e7133b8d"
      }
    },
    "owner": "angshumann"
  }
}
